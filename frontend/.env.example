# Konfigurasi API frontend (salin menjadi .env.local)
# true  = gunakan data contoh lokal (default, sebelum API Anggota 2 siap)
# false = panggil API sesuai PRD Bagian 15
NEXT_PUBLIC_USE_MOCK=true

# Base URL API. Kosongkan jika API berjalan di origin yang sama (Next.js Route Handlers).
NEXT_PUBLIC_API_BASE_URL=

# Timeout permintaan API (ms)
NEXT_PUBLIC_API_TIMEOUT_MS=10000
