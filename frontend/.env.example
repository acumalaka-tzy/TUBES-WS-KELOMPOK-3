# Konfigurasi API frontend (salin menjadi .env.local)
# true  = gunakan data contoh lokal
# false = panggil API sesuai PRD Bagian 15
NEXT_PUBLIC_USE_MOCK=false

# Base URL API. Kosongkan jika API berjalan di origin yang sama (Next.js Route Handlers).
NEXT_PUBLIC_API_BASE_URL=

# Timeout permintaan API (ms)
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Apache Jena Fuseki Endpoint
FUSEKI_QUERY_ENDPOINT=http://localhost:3030/mk_nexus/query

# ========================================================
# Google Gemini API & LLM RAG Configuration
# Dapatkan API Key resmi gratis melalui https://aistudio.google.com/app/apikey
# ========================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_MS=60000

# Next.js Settings
NEXT_PRIVATE_DISABLE_DEV_OVERLAY_UX=1
