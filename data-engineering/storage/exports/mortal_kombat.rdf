    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Li Mei unleashes purple festive chi sparks that juggle airborne targets.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-energy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-sun-ray">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sun God's Ray</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Summoning a focused beam of sunlight that burns enemies while healing allies.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-fire"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/weapon-bionic-arms">
    <rdf:type rdf:resource="https://example.org/mk/Weapon"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cybernetic Bionic Arms</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titanium bionic arm enhancements worn by Major Jackson 'Jax' Briggs.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-puke-puddle">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hazardous Fluid Puddle</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bo' Rai Cho coats the arena floor causing approaching enemies to lose their balance.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-energy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/fatality-fan-decapitation">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fatality: Decapitating Fans</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slicing off the opponent's head with a swift flick of dual steel war fans.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-wind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/org-brotherhood-of-shadow">
    <rdf:type rdf:resource="https://example.org/mk/Organization"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brotherhood of Shadow</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fanatical Netherrealm religious cult serving the fallen Elder God Shinnok and sorcerer Quan Chi.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/ability-electric-fly">
    <rdf:type rdf:resource="https://example.org/mk/Ability"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electric Fly (Superman)</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propelling oneself horizontally through the air enveloped in electrical power.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-lightning"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-wind-tornado">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wind Tornado Vortex</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinning into a cyclone that lifts and disorients nearby foes.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-wind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/fatality-dragon-bite">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fatality: Dragon Feast</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morphing into a massive dragon that bites the opponent's torso in half.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-fire"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/weapon-kori-blade">
    <rdf:type rdf:resource="https://example.org/mk/Weapon"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kori Blade</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A deadly sharp broadsword conjured directly from condensed cryogenic ice.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-sonic-scream">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
