  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/character-fujin">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fujin</mk:name>
    <mk:alternateName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">God of Wind</mk:alternateName>
    <mk:firstAppearanceYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1997</mk:firstAppearanceYear>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raiden's divine brother and God of Wind dedicated to defending humanity.</mk:description>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Fujin</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-fujin-mk11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/event-battle-of-armageddon">
    <rdf:type rdf:resource="https://example.org/mk/Event"/>
    <mk:eventTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Battle of the Pyramid of Argus</mk:eventTitle>
    <mk:eventSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All warriors clash in Edenia. Shao Kahn emerges victorious, forcing Raiden to send a psychic warning into the past.</mk:eventSummary>
    <mk:occursIn rdf:resource="https://example.org/mk/timeline-original"/>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Battle_of_Armageddon</mk:sourceURL>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-raiden"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-shaokahn"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-scorpion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/timeline-reboot">
    <rdf:type rdf:resource="https://example.org/mk/Timeline"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reboot Timeline</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Created when Raiden sent a psychic message to his past self during Armageddon ('He must win'), altering events from MK9 to MK11.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/character-cyrax">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cyrax</mk:name>
