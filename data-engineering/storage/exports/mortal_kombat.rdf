  <rdf:Description rdf:about="https://example.org/mk/game-mk-shaolin-monks-2005">
    <rdf:type rdf:resource="https://example.org/mk/Game"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mortal Kombat: Shaolin Monks</mk:name>
    <mk:releaseDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-09-16</mk:releaseDate>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Co-op action-adventure following Liu Kang and Kung Lao through the events of MKII.</mk:description>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat:_Shaolin_Monks</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/ability-flame-aura">
    <rdf:type rdf:resource="https://example.org/mk/Ability"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flame Aura</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surrounding the body in intense heat that incinerates nearby foes.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-fire"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/character-shaokahn">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shao Kahn</mk:name>
    <mk:alternateName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emperor of Outworld</mk:alternateName>
    <mk:firstAppearanceYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1993</mk:firstAppearanceYear>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ruthless tyrannical conqueror and Emperor of Outworld wielding the massive Wrath Hammer.</mk:description>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Shao_Kahn</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-shaokahn-mk11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/event-shirai-ryu-massacre">
    <rdf:type rdf:resource="https://example.org/mk/Event"/>
    <mk:eventTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Massacre of the Shirai Ryu</mk:eventTitle>
    <mk:eventSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The treacherous annihilation of Hanzo Hasashi's clan and family, orchestrated by Quan Chi.</mk:eventSummary>
    <mk:occursIn rdf:resource="https://example.org/mk/timeline-original"/>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Shirai_Ryu</mk:sourceURL>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-scorpion"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-quanchi"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-subzero"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-cyber-trap">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryo Floor Trap</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frost releases a cryogenic ground mine that flash-freezes unobservant opponents.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-ice"/>
  </rdf:Description>
