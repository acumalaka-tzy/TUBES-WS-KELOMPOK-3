  <rdf:Description rdf:about="https://example.org/mk/character-scorpion">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scorpion</mk:name>
    <mk:alternateName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hanzo Hasashi</mk:alternateName>
    <mk:firstAppearanceYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1992</mk:firstAppearanceYear>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resurrected Shirai Ryu ninja seeking vengeance for his family and clan.</mk:description>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Scorpion</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-scorpion-classic"/>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-scorpion-mk11"/>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-scorpion-mk1-2023"/>
    <mk:enemyOf rdf:resource="https://example.org/mk/character-subzero"/>
    <mk:enemyOf rdf:resource="https://example.org/mk/character-quanchi"/>
    <mk:alliedWith rdf:resource="https://example.org/mk/character-subzero"/>
  </rdf:Description>
