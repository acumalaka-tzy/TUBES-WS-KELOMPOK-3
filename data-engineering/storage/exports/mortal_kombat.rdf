    <mk:eventSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kronika collapses time, bringing younger past versions of warriors into the present era.</mk:eventSummary>
    <mk:occursIn rdf:resource="https://example.org/mk/timeline-reboot"/>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat_11</mk:sourceURL>
