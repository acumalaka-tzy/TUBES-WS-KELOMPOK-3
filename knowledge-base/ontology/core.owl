  <rdf:Description rdf:about="https://example.org/mk/StoryClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Story Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdfs:comment xml:lang="en">A narrative statement (about an event or a relationship between characters) bound to one or more timelines and backed by a Source. Keeps contradicting lore from different timelines apart</rdfs:comment>
  </rdf:Description>
