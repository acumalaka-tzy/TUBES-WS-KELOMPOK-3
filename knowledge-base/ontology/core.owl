<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/mk/follows">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/mk/Event"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Event"/>
    <rdfs:label xml:lang="en">follows</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/eventCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">event count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="https://example.org/mk/StoryTimeline"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/StoryArc">
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A sequence of connected events</rdfs:comment>
    <rdfs:label xml:lang="en">Story Arc</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/versionSequence">
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:label xml:lang="en">version sequence</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment xml:lang="en">1-based position of this version among all versions of the same character (by release date)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Event">
    <rdfs:comment xml:lang="en">A narrative event occurring in the Mortal Kombat story (Story Event)</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdfs:label xml:lang="en">Story Event</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/relatedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb20"/>
    <rdfs:label xml:lang="en">related to</rdfs:label>
    <rdfs:range rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb23"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/allyOf">
    <owl:equivalentProperty rdf:resource="https://example.org/mk/alliedWith"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb32"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/mk/alliedWith"/>
    <rdfs:range rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb35"/>
    <rdfs:label xml:lang="en">ally of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/evidenceText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">evidence text</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/mk/StoryClaim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/occursIn">
    <rdfs:range rdf:resource="https://example.org/mk/Timeline"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">occurs in</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/mk/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/versionOf">
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:label xml:lang="en">version of</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/mk/Character"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment xml:lang="en">Every CharacterVersion belongs to exactly one Character</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/rivalOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/mk/enemyOf"/>
    <rdfs:domain rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb44"/>
    <rdfs:range rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb47"/>
    <rdfs:label xml:lang="en">rival of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/StoryTimeline">
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdfs:label xml:lang="en">Story Timeline</rdfs:label>
    <rdfs:comment xml:lang="en">The chronologically ordered sequence of Story Events that belong to exactly one Timeline</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/lastEvent">
    <rdfs:subPropertyOf rdf:resource="https://example.org/mk/hasStoryEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/StoryTimeline"/>
    <rdfs:range rdf:resource="https://example.org/mk/Event"/>
    <rdfs:label xml:lang="en">last event</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/locatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">located in</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/mk/Location"/>
    <rdfs:range rdf:resource="https://example.org/mk/Location"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/versionYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    <rdfs:label xml:lang="en">version year</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb18"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/CharacterVersion">
    <rdfs:label xml:lang="en">Character Version</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A specific incarnation of a Character in exactly one Game and one Timeline. Carries clan, abilities and weapons of that context</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb7">
    <rdf:rest rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb8"/>
    <rdf:first rdf:resource="https://example.org/mk/Ability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/name">
    <rdfs:domain rdf:resource="https://example.org/mk/Entity"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/existsInTimeline">
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:label xml:lang="en">exists in timeline</rdfs:label>
    <owl:inverseOf rdf:resource="https://example.org/mk/hasTimelineVersion"/>
    <rdfs:comment xml:lang="en">A CharacterVersion belongs to exactly one Timeline; this is what separates one incarnation from another across continuities</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/mk/Timeline"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/sourceURL">
    <rdfs:domain rdf:resource="https://example.org/mk/Entity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">source URL</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb47">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb48"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Organization">
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdfs:comment xml:lang="en">A clan, syndicate, or military organization</rdfs:comment>
    <rdfs:label xml:lang="en">Organization</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb8">
    <rdf:rest rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb9"/>
    <rdf:first rdf:resource="https://example.org/mk/Element"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/firstAppearanceYear">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    <rdfs:label xml:lang="en">first appearance year</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Realm">
    <rdfs:label xml:lang="en">Realm</rdfs:label>
    <rdfs:comment xml:lang="en">Dimensional plane (Earthrealm, Outworld, Netherrealm, Edenia, etc.)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Location"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/usesWeapon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:label xml:lang="en">uses weapon</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/mk/Weapon"/>
    <owl:inverseOf rdf:resource="https://example.org/mk/usedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/releaseDate">
    <rdfs:label xml:lang="en">release date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Game"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/involvesVersion">
    <rdfs:comment xml:lang="en">The CharacterVersion (of the event's timeline) that took part in the event</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">involves version</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/mk/Event"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb25">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://example.org/mk/CharacterVersion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/chronologicalPeriod">
    <rdfs:label xml:lang="en">chronological period</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Timeline"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/partOfArc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Event"/>
    <rdfs:label xml:lang="en">part of arc</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/mk/StoryArc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/precedes">
    <owl:inverseOf rdf:resource="https://example.org/mk/follows"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Event"/>
    <rdfs:range rdf:resource="https://example.org/mk/Event"/>
    <rdfs:label xml:lang="en">precedes</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/alliedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb26"/>
    <rdfs:label xml:lang="en">allied with</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://example.org/mk/relatedTo"/>
    <rdfs:range rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb29"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb10">
    <rdf:first rdf:resource="https://example.org/mk/Organization"/>
    <rdf:rest rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/hasAbility">
    <rdfs:range rdf:resource="https://example.org/mk/Ability"/>
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:label xml:lang="en">has ability</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Weapon">
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Weapon or combat gear used by fighters</rdfs:comment>
    <rdfs:label xml:lang="en">Weapon</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Species">
    <rdfs:label xml:lang="en">Species</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Biological or mythical species (Human, Cryomancer, Edenian, God, etc.)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/gameEra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Game"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">game era</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb15">
    <rdf:rest rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb16"/>
    <rdf:first rdf:resource="https://example.org/mk/StoryClaim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/hasElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Ability"/>
    <rdfs:label xml:lang="en">has element</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/mk/Element"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/featuresInGame">
    <rdfs:range rdf:resource="https://example.org/mk/Game"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Event"/>
    <rdfs:label xml:lang="en">features in game</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/nextVersion">
    <rdfs:label xml:lang="en">next version</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <owl:inverseOf rdf:resource="https://example.org/mk/previousVersion"/>
    <rdfs:range rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:comment xml:lang="en">Next incarnation of the same character ordered by game release date</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/originatesFrom">
    <rdfs:label xml:lang="en">originates from</rdfs:label>
    <rdfs:domain rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb17"/>
    <rdfs:range rdf:resource="https://example.org/mk/Location"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/alternateName">
    <rdfs:domain rdf:resource="https://example.org/mk/Entity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">alternate name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Location">
    <rdfs:label xml:lang="en">Location</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Arena, region, or landmark</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb39">
    <rdf:rest rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb40"/>
    <rdf:first rdf:resource="https://example.org/mk/Character"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/versionLabel">
    <rdfs:comment xml:lang="en">Human readable label combining character, game and timeline</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdfs:label xml:lang="en">version label</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3abda64add404e7c9e2ebaeec1659e1bb34">
    <rdf:first rdf:resource="https://example.org/mk/CharacterVersion"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Entity">
    <rdfs:label xml:lang="en">Entity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Root entity of the Mortal Kombat universe</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/eventSummary">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">event summary</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/mk/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/Ability">
    <rdfs:label xml:lang="en">Ability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/mk/Entity"/>
