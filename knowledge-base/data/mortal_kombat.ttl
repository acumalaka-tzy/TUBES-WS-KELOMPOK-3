    mk:hasVersion mk:version-havik-mk1-2023 ;
    mk:name "Havik"^^xsd:string ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Havik"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

