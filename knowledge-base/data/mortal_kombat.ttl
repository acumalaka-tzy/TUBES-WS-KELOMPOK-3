@prefix mk: <https://example.org/mk/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mk:event-battle-for-the-hourglass a mk:Event ;
    mk:eventSummary "Combined allied armies storm Kronika's fortress to seize control of the Hourglass and prevent temporal extinction."^^xsd:string ;
    mk:eventTitle "Battle for the Keep of Time"^^xsd:string ;
    mk:involvesCharacter mk:character-kitana,
        mk:character-kronika,
        mk:character-liukang,
        mk:character-raiden ;
    mk:occursIn mk:timeline-reboot ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Hourglass"^^xsd:anyURI .

mk:event-battle-of-armageddon a mk:Event ;
    mk:eventSummary "All warriors clash in Edenia. Shao Kahn emerges victorious, forcing Raiden to send a psychic warning into the past."^^xsd:string ;
    mk:eventTitle "The Battle of the Pyramid of Argus"^^xsd:string ;
    mk:involvesCharacter mk:character-raiden,
        mk:character-scorpion,
        mk:character-shaokahn ;
    mk:occursIn mk:timeline-original ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Battle_of_Armageddon"^^xsd:anyURI .

mk:event-cassie-defeats-shinnok a mk:Event ;
    mk:eventSummary "Cassie Cage awakens her ancient green shadow halo energy to defeat Corrupted Shinnok and purify the Earthrealm Jinsei."^^xsd:string ;
    mk:eventTitle "Fall of Corrupted Shinnok"^^xsd:string ;
    mk:involvesCharacter mk:character-cassiecage,
        mk:character-johnnycage,
        mk:character-shinnok ;
    mk:occursIn mk:timeline-reboot ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_X"^^xsd:anyURI .

mk:event-creation-of-new-era a mk:Event ;
    mk:eventSummary "Fire God Liu Kang uses the Hourglass to reset the universe, giving Kombatants second chances."^^xsd:string ;
    mk:eventTitle "Birth of the New Era"^^xsd:string ;
    mk:involvesCharacter mk:character-geras,
        mk:character-liukang ;
    mk:occursIn mk:timeline-new-era ;
    mk:sourceURL "https://www.mortalkombat.com/en-us"^^xsd:anyURI .

mk:event-deadly-alliance-formed a mk:Event ;
    mk:eventSummary "Shang Tsung and Quan Chi join forces, assassinating Shao Kahn and Liu Kang to resurrect the Dragon King's army."^^xsd:string ;
    mk:eventTitle "Formation of the Deadly Alliance"^^xsd:string ;
    mk:involvesCharacter mk:character-liukang,
        mk:character-quanchi,
        mk:character-shangtsung ;
    mk:occursIn mk:timeline-original ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Deadly_Alliance"^^xsd:anyURI .

mk:event-earthrealm-invasion a mk:Event ;
    mk:eventSummary "Shao Kahn resurrects Queen Sindel on Earth, merging Outworld with Earthrealm by force."^^xsd:string ;
    mk:eventTitle "Shao Kahn's Invasion of Earthrealm"^^xsd:string ;
    mk:involvesCharacter mk:character-raiden,
        mk:character-shaokahn,
        mk:character-sonyablade ;
    mk:occursIn mk:timeline-original ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_3"^^xsd:anyURI .

mk:event-first-mk-tournament a mk:Event ;
    mk:eventSummary "Liu Kang defeats Goro and Shang Tsung to prevent Outworld from conquering Earthrealm."^^xsd:string ;
    mk:eventTitle "Tenth Mortal Kombat Tournament"^^xsd:string ;
    mk:involvesCharacter mk:character-liukang,
        mk:character-raiden,
        mk:character-shangtsung ;
    mk:occursIn mk:timeline-original ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_Tournament"^^xsd:anyURI .

mk:event-lin-kuei-cyber-initiative a mk:Event ;
    mk:eventSummary "The Lin Kuei converts its assassins into emotionless cybernetic units, targeting Smoke and Sub-Zero."^^xsd:string ;
    mk:eventTitle "The Cyber Initiative"^^xsd:string ;
    mk:involvesCharacter mk:character-cyrax,
        mk:character-sektor,
        mk:character-subzero ;
    mk:occursIn mk:timeline-reboot ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Cyber_Initiative"^^xsd:anyURI .

mk:event-outworld-tournament a mk:Event ;
    mk:eventSummary "Earthrealm warriors travel to Outworld after Shao Kahn lures them into a secondary tournament."^^xsd:string ;
    mk:eventTitle "Tournament in Outworld"^^xsd:string ;
    mk:involvesCharacter mk:character-kitana,
        mk:character-liukang,
        mk:character-shaokahn ;
    mk:occursIn mk:timeline-original ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_II"^^xsd:anyURI .

mk:event-pact-of-fire-and-ice a mk:Event ;
    mk:eventSummary "Kuai Liang reveals Quan Chi's deceit to Hanzo Hasashi, establishing peace between Shirai Ryu and Lin Kuei."^^xsd:string ;
    mk:eventTitle "Pact of Fire and Ice"^^xsd:string ;
    mk:involvesCharacter mk:character-scorpion,
        mk:character-subzero ;
    mk:occursIn mk:timeline-reboot ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_X"^^xsd:anyURI .

mk:event-raiden-vision-reset a mk:Event ;
    mk:eventSummary "Raiden alters history during the first tournament upon receiving visions from the future."^^xsd:string ;
    mk:eventTitle "Raiden's Temporal Message (He Must Win)"^^xsd:string ;
    mk:involvesCharacter mk:character-liukang,
        mk:character-raiden ;
    mk:occursIn mk:timeline-reboot ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_(2011_video_game)"^^xsd:anyURI .

mk:event-resurrection-of-onaga a mk:Event ;
    mk:eventSummary "Onaga returns from the dead to reclaim Outworld's throne, breaking the Deadly Alliance and forcing Raiden to sacrifice himself."^^xsd:string ;
    mk:eventTitle "Return of the Dragon King"^^xsd:string ;
    mk:involvesCharacter mk:character-quanchi,
        mk:character-raiden,
        mk:character-shangtsung ;
    mk:occursIn mk:timeline-original ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Onaga"^^xsd:anyURI .

mk:event-shinnok-invasion a mk:Event ;
    mk:eventSummary "Fallen Elder God Shinnok leads Netherrealm revenants in an assault on the Jinsei Chamber before being trapped inside his own amulet."^^xsd:string ;
    mk:eventTitle "Netherrealm War Against Earthrealm"^^xsd:string ;
    mk:involvesCharacter mk:character-quanchi,
        mk:character-raiden,
        mk:character-shinnok ;
    mk:occursIn mk:timeline-reboot ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Netherrealm_War"^^xsd:anyURI .

mk:event-shirai-ryu-massacre a mk:Event ;
    mk:eventSummary "The treacherous annihilation of Hanzo Hasashi's clan and family, orchestrated by Quan Chi."^^xsd:string ;
    mk:eventTitle "Massacre of the Shirai Ryu"^^xsd:string ;
    mk:involvesCharacter mk:character-quanchi,
        mk:character-scorpion,
        mk:character-subzero ;
    mk:occursIn mk:timeline-original ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Shirai_Ryu"^^xsd:anyURI .

mk:event-time-merger a mk:Event ;
    mk:eventSummary "Kronika collapses time, bringing younger past versions of warriors into the present era."^^xsd:string ;
    mk:eventTitle "Kronika's Temporal Convergence"^^xsd:string ;
    mk:involvesCharacter mk:character-geras,
        mk:character-kronika,
        mk:character-raiden,
        mk:character-scorpion ;
    mk:occursIn mk:timeline-reboot ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_11"^^xsd:anyURI .

mk:fatality-fan-decapitation a mk:Move ;
    mk:description "Slicing off the opponent's head with a swift flick of dual steel war fans."^^xsd:string ;
    mk:hasElement mk:element-wind ;
    mk:name "Fatality: Decapitating Fans"^^xsd:string .

mk:fatality-kiss-of-death a mk:Move ;
    mk:description "Blowing a glowing kiss of energy that causes the opponent to violently detonate."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Fatality: Kiss of Death"^^xsd:string .

mk:game-mk-armageddon-2006 a mk:Game ;
    mk:description "Climax of the original continuity featuring all 62 fighters competing at the Pyramid of Argus."^^xsd:string ;
    mk:name "Mortal Kombat: Armageddon"^^xsd:string ;
    mk:releaseDate "2006-10-11"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat:_Armageddon"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-mk-deadly-alliance-2002 a mk:Game ;
    mk:description "Reinvented combat mechanics with three fighting styles per fighter and the alliance of Shang Tsung and Quan Chi."^^xsd:string ;
    mk:name "Mortal Kombat: Deadly Alliance"^^xsd:string ;
    mk:releaseDate "2002-11-16"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat:_Deadly_Alliance"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-mk-deception-2004 a mk:Game ;
    mk:description "Features the return of the Dragon King Onaga and the Konquest adventure mode."^^xsd:string ;
    mk:name "Mortal Kombat: Deception"^^xsd:string ;
    mk:releaseDate "2004-10-04"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat:_Deception"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-mk-mythologies-1997 a mk:Game ;
    mk:description "Action-adventure prequel following Bi-Han acquiring Shinnok's amulet for Quan Chi."^^xsd:string ;
    mk:name "Mortal Kombat Mythologies: Sub-Zero"^^xsd:string ;
    mk:releaseDate "1997-10-01"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_Mythologies:_Sub-Zero"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-mk-shaolin-monks-2005 a mk:Game ;
    mk:description "Co-op action-adventure following Liu Kang and Kung Lao through the events of MKII."^^xsd:string ;
    mk:name "Mortal Kombat: Shaolin Monks"^^xsd:string ;
    mk:releaseDate "2005-09-16"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat:_Shaolin_Monks"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-mk3-1995 a mk:Game ;
    mk:description "Chronicles Shao Kahn's invasion of Earthrealm, introducing Cyber Ninjas."^^xsd:string ;
    mk:name "Mortal Kombat 3"^^xsd:string ;
    mk:releaseDate "1995-04-15"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_3"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-mk4-1997 a mk:Game ;
    mk:description "The first 3D installment focusing on the fallen Elder God Shinnok's war."^^xsd:string ;
    mk:name "Mortal Kombat 4"^^xsd:string ;
    mk:releaseDate "1997-10-15"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_4"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-mkt-1996 a mk:Game ;
    mk:description "Standalone anthology featuring almost every fighter from the first three games."^^xsd:string ;
    mk:name "Mortal Kombat Trilogy"^^xsd:string ;
    mk:releaseDate "1996-10-10"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_Trilogy"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:game-umk3-1995 a mk:Game ;
    mk:description "Standalone arcade update bringing back Scorpion, Kitana, and classic ninjas."^^xsd:string ;
    mk:name "Ultimate Mortal Kombat 3"^^xsd:string ;
    mk:releaseDate "1995-10-06"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Ultimate_Mortal_Kombat_3"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:move-acid-spit a mk:Move ;
    mk:description "Ejecting caustic digestive acid that melts armor and flesh on contact."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Corrosive Acid Spit"^^xsd:string .

mk:move-air-throw a mk:Move ;
    mk:description "Jax grabs the opponent out of mid-air and violently slams them to the turf."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Aerial Combat Throw"^^xsd:string .

mk:move-bone-twist a mk:Move ;
    mk:description "Havik twists his own torso a full 360 degrees to strike backward unpredictably."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "360 Torso Contortion"^^xsd:string .

mk:move-cyber-trap a mk:Move ;
    mk:description "Frost releases a cryogenic ground mine that flash-freezes unobservant opponents."^^xsd:string ;
    mk:hasElement mk:element-ice ;
    mk:name "Cryo Floor Trap"^^xsd:string .

mk:move-energy-spark a mk:Move ;
    mk:description "Li Mei unleashes purple festive chi sparks that juggle airborne targets."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Luminescent Spark Burst"^^xsd:string .

mk:move-missile-salvo a mk:Move ;
    mk:description "Chest-mounted rocket targeting enemy coordinates with thermal tracking."^^xsd:string ;
    mk:hasElement mk:element-fire ;
    mk:name "Homing Missile"^^xsd:string .

mk:move-net-tangle a mk:Move ;
    mk:description "Firing an electrified green plasma net that immobilizes targets."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Energy Net"^^xsd:string .

mk:move-puke-puddle a mk:Move ;
    mk:description "Bo' Rai Cho coats the arena floor causing approaching enemies to lose their balance."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Hazardous Fluid Puddle"^^xsd:string .

mk:move-ring-toss a mk:Move ;
    mk:description "Wrist-blaster concentric sonic rings that slice through incoming projectiles."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Energy Ring Toss"^^xsd:string .

mk:move-shadow-slide a mk:Move ;
    mk:description "Noob Saibot dispatches his shadow clone sliding forward to trip the enemy."^^xsd:string ;
    mk:hasElement mk:element-shadow ;
    mk:name "Shadow Slide"^^xsd:string .

mk:move-soul-ball a mk:Move ;
    mk:description "Harnessing stolen souls into an explosive sphere of spiritual energy."^^xsd:string ;
    mk:hasElement mk:element-soul ;
    mk:name "Green Soul Burst"^^xsd:string .

mk:move-square-wave a mk:Move ;
    mk:description "Mid-air dive propelled by acrobatic Edenian momentum."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Square Wave Flight"^^xsd:string .

mk:move-tarkatan-chop a mk:Move ;
    mk:description "Rapid succession of vicious slashes from forearm arm blades."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Blade Fury"^^xsd:string .

mk:move-tele-flurry a mk:Move ;
    mk:description "Kenshi telepathically projects a warrior spirit to slash the opponent from afar."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Tele-Flurry"^^xsd:string .

mk:move-telekinesis-slam a mk:Move ;
    mk:description "Lifting enemies telepathically and slamming them forcefully against the arena floor."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Telekinetic Slam"^^xsd:string .

mk:move-wind-kick a mk:Move ;
    mk:description "Fujin spins horizontally on a cushion of wind, striking repeatedly."^^xsd:string ;
    mk:hasElement mk:element-wind ;
    mk:name "Tornado Gale Kick"^^xsd:string .

mk:realm-chaosrealm a mk:Realm ;
    mk:description "An anarchic realm of shifting structures and freedom where chaos is worshiped as supreme truth."^^xsd:string ;
    mk:name "Chaosrealm"^^xsd:string .

mk:realm-earthrealm a mk:Realm ;
    mk:description "Home realm of mortal humanity, protected historically by the Thunder God Raiden and now Fire God Liu Kang."^^xsd:string ;
    mk:name "Earthrealm"^^xsd:string .

mk:realm-edenia a mk:Realm ;
    mk:description "A lush paradise realm of beauty and longevity, merged with Outworld for millennia before its restoration."^^xsd:string ;
    mk:name "Edenia"^^xsd:string .

mk:realm-netherrealm a mk:Realm ;
    mk:description "The fiery subterranean plane of eternal torment, demons, revenants, and dark necromancy."^^xsd:string ;
    mk:name "Netherrealm"^^xsd:string .

mk:realm-orderrealm a mk:Realm ;
    mk:description "A rigid geometric realm governed strictly by law, hierarchy, and absolute order."^^xsd:string ;
    mk:name "Orderrealm (Seido)"^^xsd:string .

mk:realm-outworld a mk:Realm ;
    mk:description "A harsh, majestic imperial realm forged by conquering and merging neighboring worlds."^^xsd:string ;
    mk:name "Outworld"^^xsd:string .

mk:weapon-hookswords a mk:Weapon ;
    mk:description "Kabal and Mavado's traditional curved hookswords used for trapping weapons and swinging opponents."^^xsd:string ;
    mk:name "Tiger Hookswords"^^xsd:string .

mk:ability-electric-fly a mk:Ability ;
    mk:description "Propelling oneself horizontally through the air enveloped in electrical power."^^xsd:string ;
    mk:hasElement mk:element-lightning ;
    mk:name "Electric Fly (Superman)"^^xsd:string .

mk:ability-flame-aura a mk:Ability ;
    mk:description "Surrounding the body in intense heat that incinerates nearby foes."^^xsd:string ;
    mk:hasElement mk:element-fire ;
    mk:name "Flame Aura"^^xsd:string .

mk:ability-ice-clone a mk:Ability ;
    mk:description "Leaving behind a flash-frozen decoy that freezes whoever touches it."^^xsd:string ;
    mk:hasElement mk:element-ice ;
    mk:name "Ice Clone"^^xsd:string .

mk:ability-ice-slide a mk:Ability ;
    mk:description "Coating the ground with ice to slide swiftly beneath enemy defenses."^^xsd:string ;
    mk:hasElement mk:element-ice ;
    mk:name "Ice Slide"^^xsd:string .

mk:ability-soul-stealing a mk:Ability ;
    mk:description "Draining an opponent's soul to heal and assume their appearance and abilities."^^xsd:string ;
    mk:hasElement mk:element-soul ;
    mk:name "Soul Steal"^^xsd:string .

mk:character-baraka a mk:Character ;
    mk:alternateName "Tarkatan War Chief"^^xsd:string ;
    mk:description "Ferocious warlord of the nomadic Tarkatan tribe with retractable arm blades."^^xsd:string ;
    mk:firstAppearanceYear "1993"^^xsd:gYear ;
    mk:hasVersion mk:version-baraka-mk11 ;
    mk:name "Baraka"^^xsd:string ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Baraka"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:character-boraicho a mk:Character ;
    mk:alternateName "Master of the Drunken Fist"^^xsd:string ;
    mk:description "Outworld martial arts master who trained legendary champions Liu Kang and Kung Lao."^^xsd:string ;
    mk:firstAppearanceYear "2002"^^xsd:gYear ;
    mk:hasVersion mk:version-boraicho-mkx ;
    mk:name "Bo' Rai Cho"^^xsd:string ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Bo%27_Rai_Cho"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:character-erronblack a mk:Character ;
    mk:alternateName "Outworld Gunslinger"^^xsd:string ;
    mk:description "19th-century Earthrealm gunfighter granted prolonged life by Shang Tsung, working as an Outworld mercenary."^^xsd:string ;
    mk:firstAppearanceYear "2015"^^xsd:gYear ;
    mk:hasVersion mk:version-erronblack-mk11 ;
    mk:name "Erron Black"^^xsd:string ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Erron_Black"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:character-frost a mk:Character ;
    mk:alternateName "Cyber Frost"^^xsd:string ;
    mk:description "Ambitious Lin Kuei cryomancer prodigy who rebelled against Sub-Zero and embraced cybernetization."^^xsd:string ;
    mk:enemyOf mk:character-subzero ;
    mk:firstAppearanceYear "2002"^^xsd:gYear ;
    mk:hasVersion mk:version-frost-mk11 ;
    mk:name "Frost"^^xsd:string ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Frost"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:character-fujin a mk:Character ;
    mk:alternateName "God of Wind"^^xsd:string ;
    mk:description "Raiden's divine brother and God of Wind dedicated to defending humanity."^^xsd:string ;
    mk:firstAppearanceYear "1997"^^xsd:gYear ;
    mk:hasVersion mk:version-fujin-mk11 ;
    mk:name "Fujin"^^xsd:string ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Fujin"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:character-goro a mk:Character ;
    mk:alternateName "Prince Goro"^^xsd:string ;
    mk:description "Four-armed Shokan prince and 500-year undefeated champion of the Mortal Kombat tournament."^^xsd:string ;
    mk:firstAppearanceYear "1992"^^xsd:gYear ;
    mk:hasVersion mk:version-goro-classic ;
    mk:name "Goro"^^xsd:string ;
