mk:element-blood a mk:Element ;
    mk:name "Blood"^^xsd:string .

mk:fatality-dragon-bite a mk:Move ;
    mk:description "Morphing into a massive dragon that bites the opponent's torso in half."^^xsd:string ;
    mk:hasElement mk:element-fire ;
    mk:name "Fatality: Dragon Feast"^^xsd:string .

mk:fatality-shokan-tear a mk:Move ;
    mk:description "Goro grabs both arms and legs, tearing the opponent into four separate pieces."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Fatality: Limb Disassembly"^^xsd:string .

mk:fatality-spine-rip a mk:Move ;
    mk:description "Grabbing the victim's neck and cleanly ripping out their head and spine."^^xsd:string ;
    mk:hasElement mk:element-ice ;
    mk:name "Fatality: Spine Rip"^^xsd:string .

mk:fatality-toasty a mk:Move ;
    mk:description "Removing the mask to reveal a flaming skull and incinerating the opponent to ashes."^^xsd:string ;
    mk:hasElement mk:element-fire ;
    mk:name "Fatality: Toasty!"^^xsd:string .

mk:game-mk9-2011 a mk:Game ;
    mk:description "Timeline reset orchestrated by Raiden rewinding the events of MK1 through MK3."^^xsd:string ;
    mk:name "Mortal Kombat (2011)"^^xsd:string ;
    mk:releaseDate "2011-04-19"^^xsd:date ;
    mk:sourceURL "https://mortalkombat.fandom.com/wiki/Mortal_Kombat_(2011_video_game)"^^xsd:anyURI ;
    mk:verificationStatus "verified"^^xsd:string .

mk:move-bicycle-kick a mk:Move ;
    mk:description "Defying gravity with rapid aerial bicycle kicks propelled by chi."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Bicycle Kick"^^xsd:string .

mk:move-blood-tentacles a mk:Move ;
    mk:description "Conjuring whipping tendrils of coagulated blood to lash opponents."^^xsd:string ;
    mk:hasElement mk:element-blood ;
    mk:name "Blood Tentacles"^^xsd:string .

mk:move-cannonball a mk:Move ;
    mk:description "Curling into a tightly wound ball and launching forward like a deadly sphere."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Cannonball Roll"^^xsd:string .

mk:move-drunken-fist a mk:Move ;
    mk:description "Unpredictable tumbling footwork baffling enemy guard."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Drunken Fist Roll"^^xsd:string .

mk:move-fan-lift a mk:Move ;
    mk:description "Waving bladed war fans to create an updraft that suspends opponents helplessly in mid-air."^^xsd:string ;
    mk:hasElement mk:element-wind ;
    mk:name "Fan Lift"^^xsd:string .

mk:move-flying-kick a mk:Move ;
    mk:description "Liu Kang's signature horizontal flight across the screen backed by flaming chi."^^xsd:string ;
    mk:hasElement mk:element-fire ;
    mk:name "Flying Dragon Kick"^^xsd:string .

mk:move-ground-pound a mk:Move ;
    mk:description "Striking the ground with cybernetic arms to cause localized seismic shockwaves."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Ground Pound"^^xsd:string .

mk:move-hat-throw a mk:Move ;
    mk:description "Throwing a circular razor-rimmed hat with boomerang-like trajectory."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Razor Rim Hat Toss"^^xsd:string .

mk:move-nut-punch a mk:Move ;
    mk:description "Splits on the ground delivering an unexpected disabling low strike."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Nut Punch"^^xsd:string .

mk:move-revolver-quickdraw a mk:Move ;
    mk:description "Rapid six-shooter revolver barrage accompanied by blinding Netherrealm sand."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Sand Slam & Quickdraw"^^xsd:string .

mk:move-sonic-scream a mk:Move ;
    mk:description "High-decibel vocal resonance that stuns and strips the skin from targets."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:name "Banshee Sonic Scream"^^xsd:string .

mk:move-sun-ray a mk:Move ;
    mk:description "Summoning a focused beam of sunlight that burns enemies while healing allies."^^xsd:string ;
    mk:hasElement mk:element-fire ;
    mk:name "Sun God's Ray"^^xsd:string .

mk:move-wind-tornado a mk:Move ;
    mk:description "Spinning into a cyclone that lifts and disorients nearby foes."^^xsd:string ;
    mk:hasElement mk:element-wind ;
    mk:name "Wind Tornado Vortex"^^xsd:string .

