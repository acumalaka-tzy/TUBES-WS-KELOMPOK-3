    rdfs:domain mk:StoryClaim ;
    rdfs:range xsd:string .

mk:claimSubject a owl:ObjectProperty ;
    rdfs:label "claim subject"@en ;
    rdfs:domain mk:StoryClaim ;
    rdfs:range mk:Character .

mk:claimText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "claim text"@en ;
    rdfs:domain mk:StoryClaim ;
    rdfs:range xsd:string .

mk:describesTimeline a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "describes timeline"@en ;
    rdfs:domain mk:StoryTimeline ;
    rdfs:range mk:Timeline ;
    owl:inverseOf mk:hasStoryTimeline .

mk:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:domain mk:Entity ;
    rdfs:range xsd:string .

mk:eventCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
