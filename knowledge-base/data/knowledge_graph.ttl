mk:fatality-bow-before-me a mk:Fatality,
        mk:Move ;
    mk:description "Jade vaults on her staff, driving both ends through the opponent's eye sockets."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Bow Before Me"^^xsd:string .

mk:fatality-divine-purification a mk:Fatality,
        mk:Move ;
    mk:description "Ashrah pierces the demon's heart with the Kriss, causing holy blue light to incinerate the body from within."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Heavenly Cleansing"^^xsd:string .

mk:fatality-face-crusher a mk:Fatality,
        mk:Move ;
    mk:description "Shujinko strikes vital meridian pressure points, causing the victim's body to cave in on itself."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Five Point Strike"^^xsd:string .

mk:fatality-fan-decapitation a mk:Fatality,
        mk:Move ;
    mk:description "Slicing off the opponent's head with a swift flick of dual steel war fans."^^xsd:string ;
    mk:hasElement mk:element-wind ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Decapitating Fans"^^xsd:string .

mk:fatality-infestation a mk:Fatality,
        mk:Move ;
    mk:description "D'Vorah fills the victim's torso with ravenous wasp larvae that burst out from the ribcage."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Bug Me"^^xsd:string .

mk:fatality-kiss-of-death a mk:Fatality,
        mk:Move ;
    mk:description "Blowing a glowing kiss of energy that causes the opponent to violently detonate."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Kiss of Death"^^xsd:string .

mk:fatality-road-rash a mk:Fatality,
        mk:Move ;
    mk:description "Kabal drags the opponent at super-speed face first across the concrete, grinding their skull away."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Road Rash"^^xsd:string .

mk:fatality-scream-queen a mk:Fatality,
        mk:Move ;
    mk:description "Sindel screams directly into the victim's mouth, causing their eyes and entrails to explode outward."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Scream Queen"^^xsd:string .

mk:fatality-spider-mines a mk:Fatality,
        mk:Move ;
    mk:description "Jacqui Briggs deploys spider mines that burrow into the opponent's joints and detonate simultaneously."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Spider Mines"^^xsd:string .

mk:fatality-spine-ripper a mk:Fatality,
        mk:Move ;
    mk:description "Sheeva grabs both sets of limbs and tears the flesh completely from the skeletal frame."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Lend a Hand"^^xsd:string .

mk:fatality-time-served a mk:Fatality,
        mk:Move ;
    mk:description "Stryker plants a grenade in the target's chest, shoots them with a taser, and detonates the charge."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Time Served"^^xsd:string .

mk:fatality-vaeternus-drain a mk:Fatality,
        mk:Move ;
    mk:description "Nitara rips open the victim's carotid artery with fangs and claws, drinking them completely dry."^^xsd:string ;
    mk:hasElement mk:element-blood ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Blood Feast"^^xsd:string .

mk:fatality-war-dance a mk:Fatality,
        mk:Move ;
    mk:description "Nightwolf embeds his tomahawks into the victim's collarbones, summoning a massive lightning bolt to split them."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Fatality"^^xsd:string ;
    mk:name "Fatality: Kompshina Calling"^^xsd:string .

mk:move-banshee-scream a mk:Move,
        mk:SpecialMove ;
    mk:description "Sindel levitates and releases sonic shriek waves that paralyze the opponent's nervous system."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Special Move"^^xsd:string ;
    mk:name "Levitating Banshee Scream"^^xsd:string .

mk:move-baton-trip a mk:Move,
        mk:SpecialMove ;
    mk:description "Kurtis Stryker hooks the enemy's legs with his police baton and slams them onto their back."^^xsd:string ;
    mk:hasElement mk:element-energy ;
    mk:moveCategory "Special Move"^^xsd:string ;
    mk:name "Baton Sweep & Toss"^^xsd:string .

mk:move-bionic-dash a mk:Move,
        mk:SpecialMove ;
