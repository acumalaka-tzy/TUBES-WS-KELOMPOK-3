@prefix mk: <https://example.org/mk/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mk:Arena a owl:Class ;
    rdfs:label "Arena"@en ;
    rdfs:comment "Fighting stage or battle venue"@en ;
    rdfs:subClassOf mk:Location .

mk:Brutality a owl:Class ;
    rdfs:label "Brutality"@en ;
    rdfs:subClassOf mk:Move .

mk:Faction a owl:Class ;
    rdfs:label "Faction"@en ;
    rdfs:subClassOf mk:Organization .

mk:aboutEvent a owl:ObjectProperty ;
    rdfs:label "about event"@en ;
    rdfs:domain mk:StoryClaim ;
    rdfs:range mk:Event ;
    owl:inverseOf mk:hasClaim .

mk:allyOf a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "ally of"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( mk:Character mk:CharacterVersion ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( mk:Character mk:CharacterVersion ) ] ;
    rdfs:subPropertyOf mk:alliedWith ;
    owl:equivalentProperty mk:alliedWith .

mk:alternateName a owl:DatatypeProperty ;
    rdfs:label "alternate name"@en ;
    rdfs:domain mk:Entity ;
    rdfs:range xsd:string .

mk:appearsIn a owl:ObjectProperty ;
    rdfs:label "appears in"@en ;
    rdfs:domain mk:CharacterVersion ;
    rdfs:range mk:Game ;
    owl:inverseOf mk:featuresVersion .

mk:canonStatus a owl:DatatypeProperty ;
    rdfs:label "canon status"@en ;
    rdfs:domain mk:Entity ;
    rdfs:range xsd:string .

mk:causedBy a owl:ObjectProperty ;
    rdfs:label "caused by"@en ;
    rdfs:domain mk:Event ;
    rdfs:range mk:Entity .

mk:chronologicalOrder a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "chronological order"@en ;
    rdfs:comment "Position of the event in the in-universe chronology"@en ;
    rdfs:domain mk:Event ;
    rdfs:range xsd:integer .

mk:chronologicalPeriod a owl:DatatypeProperty ;
    rdfs:label "chronological period"@en ;
    rdfs:domain mk:Timeline ;
    rdfs:range xsd:string .

mk:claim-rel-ashrah-enemyof-quanchi a mk:StoryClaim ;
    mk:canonStatus "canonical"^^xsd:string ;
    mk:claimContext "Original & New Era Timelines"^^xsd:string ;
    mk:claimInTimeline mk:timeline-new-era,
        mk:timeline-original ;
    mk:claimObject mk:character-quanchi ;
    mk:claimPredicate "enemyOf"^^xsd:string ;
    mk:claimSubject mk:character-ashrah ;
    mk:claimText "Ashrah renounced Netherrealm evil and hunts Quan Chi's demons to cleanse her spirit."^^xsd:string ;
    mk:evidenceText "Ashrah renounced Netherrealm evil and hunts Quan Chi's demons to cleanse her spirit."^^xsd:string ;
    mk:hasSource mk:source-mortalkombat-fandom-com-wiki-ashrah ;
    mk:name "Ashrah enemyOf Quan Chi"^^xsd:string ;
    mk:supportedBy mk:source-mortalkombat-fandom-com-wiki-ashrah ;
    mk:verificationStatus "verified"^^xsd:string .

