    rdfs:domain mk:StoryTimeline ;
    rdfs:range xsd:integer .

mk:eventSummary a owl:DatatypeProperty ;
    rdfs:label "event summary"@en ;
    rdfs:domain mk:Event ;
    rdfs:range xsd:string .

mk:eventTitle a owl:DatatypeProperty ;
    rdfs:label "event title"@en ;
    rdfs:domain mk:Event ;
    rdfs:range xsd:string .

mk:evidenceText a owl:DatatypeProperty ;
    rdfs:label "evidence text"@en ;
    rdfs:domain mk:StoryClaim ;
    rdfs:range xsd:string .

mk:existsInTimeline a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "exists in timeline"@en ;
    rdfs:comment "A CharacterVersion belongs to exactly one Timeline; this is what separates one incarnation from another across continuities"@en ;
    rdfs:domain mk:CharacterVersion ;
    rdfs:range mk:Timeline ;
    owl:inverseOf mk:hasTimelineVersion .

mk:featuresInGame a owl:ObjectProperty ;
    rdfs:label "features in game"@en ;
    rdfs:domain mk:Event ;
    rdfs:range mk:Game .

mk:firstAppearanceYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
