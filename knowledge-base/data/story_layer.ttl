    mk:description "Chronologically ordered Story Events of the New Era (3 events)."^^xsd:string ;
    mk:eventCount 3 ;
    mk:firstEvent mk:event-creation-of-new-era ;
    mk:hasStoryEvent mk:event-creation-of-new-era,
        mk:event-onslaught-mobilization,
        mk:event-unmasking-of-titan-shang ;
    mk:lastEvent mk:event-onslaught-mobilization ;
    mk:name "New Era - Story Timeline"^^xsd:string .

mk:storytimeline-original a mk:StoryTimeline ;
    mk:describesTimeline mk:timeline-original ;
    mk:description "Chronologically ordered Story Events of the Original Timeline (12 events)."^^xsd:string ;
    mk:eventCount 12 ;
    mk:firstEvent mk:event-mythologies-quest ;
    mk:hasStoryEvent mk:event-battle-of-armageddon,
        mk:event-deadly-alliance-formed,
        mk:event-earthrealm-invasion,
        mk:event-first-tournament,
        mk:event-mythologies-quest,
        mk:event-outworld-tournament,
        mk:event-resurrection-of-onaga,
        mk:event-shaolin-monks-crusade,
        mk:event-shinnok-invasion-mk4,
        mk:event-shujinko-deception,
        mk:event-special-forces-chase,
        mk:event-worlds-collide-crisis ;
    mk:lastEvent mk:event-worlds-collide-crisis ;
    mk:name "Original Timeline - Story Timeline"^^xsd:string .

mk:storytimeline-reboot a mk:StoryTimeline ;
    mk:describesTimeline mk:timeline-reboot ;
    mk:description "Chronologically ordered Story Events of the Reboot Timeline (10 events)."^^xsd:string ;
    mk:eventCount 10 ;
    mk:firstEvent mk:event-raiden-vision-reset ;
    mk:hasStoryEvent mk:event-battle-for-the-hourglass,
        mk:event-cassie-defeats-shinnok,
        mk:event-dvorah-poisons-hanzo,
        mk:event-lin-kuei-cyber-initiative,
        mk:event-outworld-civil-war,
        mk:event-pact-of-fire-and-ice,
        mk:event-raiden-vision-reset,
        mk:event-shinnok-netherrealm-war,
        mk:event-sindel-massacre,
        mk:event-time-merger ;
    mk:lastEvent mk:event-battle-for-the-hourglass ;
    mk:name "Reboot Timeline - Story Timeline"^^xsd:string .

