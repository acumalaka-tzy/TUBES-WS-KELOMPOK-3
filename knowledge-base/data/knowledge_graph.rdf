  <rdf:Description rdf:about="https://example.org/mk/timeline-original">
    <rdf:type rdf:resource="https://example.org/mk/Timeline"/>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The initial continuity spanning Mortal Kombat 1 through Mortal Kombat: Armageddon, culminating in the battle at the Pyramid of Argus.</mk:description>
    <mk:chronologicalPeriod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1992–2006</mk:chronologicalPeriod>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Original Timeline</mk:name>
