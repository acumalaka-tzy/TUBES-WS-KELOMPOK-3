    <mk:firstAppearanceYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1995</mk:firstAppearanceYear>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ruthless grandmaster's son who willingly embraced cybernetization, armed with thermal rockets and dual flamethrowers.</mk:description>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Sektor</mk:sourceURL>
