  <rdf:Description rdf:about="https://example.org/mk/game-mk-deception-2004">
    <rdf:type rdf:resource="https://example.org/mk/Game"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mortal Kombat: Deception</mk:name>
    <mk:releaseDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-10-04</mk:releaseDate>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Features the return of the Dragon King Onaga, death traps, Puzzle/Chess Kombat, and the open-world RPG Konquest adventure mode.</mk:description>
    <mk:gameEra rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3D Era</mk:gameEra>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PlayStation 2</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xbox</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GameCube</mk:supportedPlatform>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat:_Deception</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/character-hotaru">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hotaru</mk:name>
    <mk:alternateName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Commander of the Seidan Guard</mk:alternateName>
    <mk:hasSpecies rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seidan</mk:hasSpecies>
    <mk:originatesFrom rdf:resource="https://example.org/mk/realm-orderrealm"/>
    <mk:firstAppearanceYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2004</mk:firstAppearanceYear>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inflexible military commander from Orderrealm who enforces law and order with zero tolerance for chaos, even allying with Onaga to suppress rebellion.</mk:description>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Hotaru</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-hotaru-mk-deception-2004"/>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-hotaru-mk-armageddon-2006"/>
    <mk:enemyOf rdf:resource="https://example.org/mk/character-havik"/>
  </rdf:Description>
