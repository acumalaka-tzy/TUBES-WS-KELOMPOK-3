  <rdf:Description rdf:about="https://example.org/mk/event-deadly-alliance-formed">
    <rdf:type rdf:resource="https://example.org/mk/Event"/>
    <mk:eventTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Formation of the Deadly Alliance</mk:eventTitle>
    <mk:eventSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shang Tsung and Quan Chi join forces, assassinating Shao Kahn and Liu Kang to resurrect the Dragon King's mummified undefeatable army.</mk:eventSummary>
