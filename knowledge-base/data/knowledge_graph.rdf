    <mk:moveCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fatality</mk:moveCategory>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nitara rips open the victim's carotid artery with fangs and claws, drinking them completely dry.</mk:description>
