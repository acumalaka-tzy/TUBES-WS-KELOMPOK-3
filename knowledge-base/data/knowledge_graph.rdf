  <rdf:Description rdf:about="https://example.org/mk/character-jade">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jade</mk:name>
    <mk:alternateName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imperial Bodyguard of Kitana</mk:alternateName>
    <mk:hasSpecies rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edenian</mk:hasSpecies>
    <mk:originatesFrom rdf:resource="https://example.org/mk/realm-edenia"/>
    <mk:firstAppearanceYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1993</mk:firstAppearanceYear>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stealth assassin and steadfast childhood friend of Kitana, renowned for her blazing staff combat and loyalty to Edenia.</mk:description>
