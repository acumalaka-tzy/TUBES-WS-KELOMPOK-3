    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shao Kahn's devastating monolithic maul that crushes armor and bone.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/weapon-bo-staff">
    <rdf:type rdf:resource="https://example.org/mk/Weapon"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imperial Bo Staff</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jade's glowing triboluminescent steel bo staff delivering long-reach pole vault strikes.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/weapon-hookswords">
    <rdf:type rdf:resource="https://example.org/mk/Weapon"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dual Hookswords</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twin curved Chinese hook swords wielded with lethal acrobatics by Kabal and Mavado.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/org-white-lotus">
    <rdf:type rdf:resource="https://example.org/mk/Organization"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">White Lotus Society</mk:name>
