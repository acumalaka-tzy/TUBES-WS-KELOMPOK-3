  <rdf:Description rdf:about="https://example.org/mk/ability-soul-stealing">
    <rdf:type rdf:resource="https://example.org/mk/Ability"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soul Steal</mk:name>
    <mk:moveCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sorcery</mk:moveCategory>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Draining an opponent's soul to heal and assume their appearance and abilities.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-soul"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-puke-puddle">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hazardous Fluid Puddle</mk:name>
    <mk:moveCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Special Move</mk:moveCategory>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bo' Rai Cho coats the arena floor causing approaching enemies to lose their balance.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-energy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/org-special-forces">
    <rdf:type rdf:resource="https://example.org/mk/Organization"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Special Forces</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Earthrealm military division led by Sonya Blade and Jax Briggs tasked with countering otherworldly threats.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-shotel-strike">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Demonic Shotel Flurry</mk:name>
    <mk:moveCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Special Move</mk:moveCategory>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kollector slashes with curved shotel blades using four arms simultaneously.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-energy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/fatality-road-rash">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fatality: Road Rash</mk:name>
    <mk:moveCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fatality</mk:moveCategory>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kabal drags the opponent at super-speed face first across the concrete, grinding their skull away.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-energy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-rhino-charge">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rhino Charge</mk:name>
    <mk:moveCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Special Move</mk:moveCategory>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nightwolf charges forward enveloped in a mystical green aura, bowling over the target.</mk:description>
    <mk:hasElement rdf:resource="https://example.org/mk/element-energy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/element-energy">
    <rdf:type rdf:resource="https://example.org/mk/Element"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kinetic Energy</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ancient Mediterranean green glow energy, bionics, and sheer physical power.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/org-brotherhood-of-shadow">
    <rdf:type rdf:resource="https://example.org/mk/Organization"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brotherhood of Shadow</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fanatical Netherrealm religious cult serving the fallen Elder God Shinnok and sorcerer Quan Chi.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/weapon-daggers-of-denial">
    <rdf:type rdf:resource="https://example.org/mk/Weapon"/>
