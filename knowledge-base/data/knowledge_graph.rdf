    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tanya's agile Kobu Jutsu batons and dual stiletto daggers.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/weapon-war-hammer">
    <rdf:type rdf:resource="https://example.org/mk/Weapon"/>
