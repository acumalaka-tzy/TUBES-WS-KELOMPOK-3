  <rdf:Description rdf:about="https://example.org/mk/game-mk3-1995">
    <rdf:type rdf:resource="https://example.org/mk/Game"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mortal Kombat 3</mk:name>
    <mk:releaseDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1995-04-15</mk:releaseDate>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronicles Shao Kahn's invasion of Earthrealm through Sindel's resurrection, introducing Cyber Ninjas (Cyrax, Sektor, Smoke) and Kabal.</mk:description>
    <mk:gameEra rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classic Era</mk:gameEra>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arcade</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNES</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sega Genesis</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PlayStation</mk:supportedPlatform>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat_3</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
  </rdf:Description>
