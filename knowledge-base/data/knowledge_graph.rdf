  <rdf:Description rdf:about="https://example.org/mk/game-mk1-1992">
    <rdf:type rdf:resource="https://example.org/mk/Game"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mortal Kombat (1992)</mk:name>
    <mk:releaseDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1992-10-08</mk:releaseDate>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The landmark tournament fighting game created by Ed Boon and John Tobias that introduced digital sprites, Fatalities, and legendary martial lore.</mk:description>
    <mk:gameEra rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classic Era</mk:gameEra>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arcade</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNES</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sega Genesis</mk:supportedPlatform>
    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Game Boy</mk:supportedPlatform>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat_(1992_video_game)</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
  </rdf:Description>
