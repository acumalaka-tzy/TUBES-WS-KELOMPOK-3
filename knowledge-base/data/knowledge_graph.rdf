  <rdf:Description rdf:about="https://example.org/mk/game-mk-shaolin-monks-2005">
    <rdf:type rdf:resource="https://example.org/mk/Game"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mortal Kombat: Shaolin Monks</mk:name>
    <mk:releaseDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2005-09-16</mk:releaseDate>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Co-op beat-'em-up action adventure following Liu Kang and Kung Lao through the demonic hazards of Outworld during the MKII tournament.</mk:description>
    <mk:gameEra rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spin-off</mk:gameEra>
