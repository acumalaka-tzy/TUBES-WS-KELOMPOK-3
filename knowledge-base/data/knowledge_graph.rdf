    <mk:supportedPlatform rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xbox</mk:supportedPlatform>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat:_Shaolin_Monks</mk:sourceURL>
