  <rdf:Description rdf:about="https://example.org/mk/character-sareena">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sareena</mk:name>
    <mk:alternateName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assassin of the Shadow Priests</mk:alternateName>
    <mk:hasSpecies rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Demon</mk:hasSpecies>
    <mk:originatesFrom rdf:resource="https://example.org/mk/realm-netherrealm"/>
    <mk:firstAppearanceYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1997</mk:firstAppearanceYear>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Netherrealm demon assassin serving Quan Chi who rebelled after meeting Bi-Han, seeking to escape the Netherrealm and preserve her humanity.</mk:description>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Sareena</mk:sourceURL>
    <mk:verificationStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">verified</mk:verificationStatus>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-sareena-mk-mythologies-1997"/>
    <mk:hasVersion rdf:resource="https://example.org/mk/version-sareena-mk-tournament-edition-2003"/>
    <mk:alliedWith rdf:resource="https://example.org/mk/character-subzero"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/weapon-sai-daggers">
    <rdf:type rdf:resource="https://example.org/mk/Weapon"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twin Sai Daggers</mk:name>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mileena's pair of three-pronged sai daggers used for rapid stabbing and teleport throws.</mk:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/event-outworld-tournament">
    <rdf:type rdf:resource="https://example.org/mk/Event"/>
    <mk:eventTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Outworld Tournament Lure</mk:eventTitle>
    <mk:eventSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shao Kahn entices Earthrealm's defenders into Outworld; Liu Kang triumphs over Shao Kahn, while Kitana discovers her clone Mileena.</mk:eventSummary>
    <mk:chronologicalOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</mk:chronologicalOrder>
    <mk:occursInTimeline rdf:resource="https://example.org/mk/timeline-original"/>
    <mk:featuresInGame rdf:resource="https://example.org/mk/game-mk2-1993"/>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat_II</mk:sourceURL>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-shaokahn"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-liukang"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-kitana"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-mileena"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-jax"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/mk/move-telekinesis-slam">
    <rdf:type rdf:resource="https://example.org/mk/Move"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Telekinetic Slam</mk:name>
    <mk:moveCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Special Move</mk:moveCategory>
    <mk:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lifting enemies telepathically and slamming them forcefully against the arena floor.</mk:description>
