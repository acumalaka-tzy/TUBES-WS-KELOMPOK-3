  <rdf:Description rdf:about="https://example.org/mk/character-sektor">
    <rdf:type rdf:resource="https://example.org/mk/Character"/>
    <mk:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sektor</mk:name>
    <mk:alternateName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unit LK-9T9</mk:alternateName>
    <mk:hasSpecies rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cyborg / Human</mk:hasSpecies>
