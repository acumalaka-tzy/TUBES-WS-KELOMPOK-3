  <rdf:Description rdf:about="https://example.org/mk/event-time-merger">
    <rdf:type rdf:resource="https://example.org/mk/Event"/>
    <mk:eventTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kronika's Temporal Convergence</mk:eventTitle>
    <mk:eventSummary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kronika collapses time, bringing younger past versions of warriors into the present era to rewrite history without Raiden.</mk:eventSummary>
    <mk:chronologicalOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</mk:chronologicalOrder>
    <mk:occursInTimeline rdf:resource="https://example.org/mk/timeline-reboot"/>
    <mk:featuresInGame rdf:resource="https://example.org/mk/game-mk11-2019"/>
    <mk:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://mortalkombat.fandom.com/wiki/Mortal_Kombat_11</mk:sourceURL>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-kronika"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-raiden"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-scorpion"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-geras"/>
    <mk:involvesCharacter rdf:resource="https://example.org/mk/character-cetrion"/>
  </rdf:Description>
