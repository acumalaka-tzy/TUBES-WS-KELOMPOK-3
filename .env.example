# ========================================================
# Mortal Kombat Knowledge Nexus - Environment Configuration
# ========================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Mortal Kombat Knowledge Nexus"

# Apache Jena Fuseki Configuration (Standalone)
# Default Fuseki port is 3030
FUSEKI_HOST=localhost
FUSEKI_PORT=3030
FUSEKI_DATASET=mk_nexus
FUSEKI_ENDPOINT=http://localhost:3030/mk_nexus
FUSEKI_QUERY_ENDPOINT=http://localhost:3030/mk_nexus/query
FUSEKI_UPDATE_ENDPOINT=http://localhost:3030/mk_nexus/update
FUSEKI_DATA_ENDPOINT=http://localhost:3030/mk_nexus/data

# Fuseki Authentication (Optional for local dev, required for protected SPARQL/Update)
FUSEKI_USER=admin
FUSEKI_PASSWORD=adminpassword

# Search & Retrieval Configuration
DEFAULT_SEARCH_MODE=hybrid
SEARCH_PAGE_SIZE=12
SPARQL_QUERY_TIMEOUT_MS=5000

# Python Data Engineering Pipeline Paths
DATA_PIPELINE_PATH=./data-engineering
RAW_DATA_PATH=./data-engineering/storage/raw
PROCESSED_DATA_PATH=./data-engineering/storage/cleaned
EXPORT_RDF_PATH=./knowledge-base/data

# ========================================================
# Google Gemini API & LLM RAG Configuration
# Dapatkan API Key resmi gratis melalui https://aistudio.google.com/app/apikey
# ========================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_MS=60000

