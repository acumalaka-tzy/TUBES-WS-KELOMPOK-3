# ========================================================
# Git Ignore - Mortal Kombat Knowledge Nexus
# ========================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Outputs
/.next/
/out/
.next

# Production & Build Artifacts
build/
dist/

# Environment Variables
.env
.env*.local
!.env.example

# Debug and Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# Vercel & IDE
.vercel
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS Specific
.DS_Store
Thumbs.db
desktop.ini

# Python / Data Engineering Pipeline
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Data Engineering Storage & Scraped Data (Keep raw data local)
data-engineering/storage/raw/*
!data-engineering/storage/raw/.gitkeep
data-engineering/storage/cleaned/*
!data-engineering/storage/cleaned/.gitkeep
data-engineering/storage/extracted/*
!data-engineering/storage/extracted/.gitkeep
data-engineering/storage/validated/*
!data-engineering/storage/validated/.gitkeep
data-engineering/storage/assets/*
!data-engineering/storage/assets/.gitkeep

# Apache Jena Fuseki Standalone Runtime
fuseki/apache-jena-fuseki-*/
fuseki/run/
fuseki/databases/
fuseki/backups/
fuseki/*.log
fuseki/*.pid
